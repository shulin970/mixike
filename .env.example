# Copy this file to ".env" and fill in ONE of the providers below.
# (Recommended in mainland China: football-data.org — api-football.com is blocked.)

# Which provider to use:  footballdata  (default)  |  apifootball
LIVE_SOURCE=footballdata

# ---- football-data.org (free, email signup, works in China) ----
# Get a token at https://www.football-data.org/  → "Get your API key"
FD_API_TOKEN=your_token_here

# ---- api-football (api-sports.io) — alternative if you can reach it ----
API_SPORTS_KEY=your_key_here

# Keys stay on the server side (Vite dev proxy / server.mjs) — never shipped
# to the browser.
